# Normalize line endings so Windows and macOS/Linux checkouts don't produce
# whole-file diffs. Text is stored LF in the repo and checked out natively.
* text=auto

*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf

# The Whisper runtime and model wasm are binary — never touch them, and keep
# them out of language stats so GitHub reports this as a TypeScript project.
extension/libs/**  binary linguist-vendored
*.wasm             binary
*.png              binary

# Generated bundle: collapsed in diffs and excluded from language stats.
extension/content.js linguist-generated
